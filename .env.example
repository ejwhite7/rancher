SITE_URL=https://your-domain.example
BOOKING_URL=https://cal.com/rancher/discovery
# Provisioned server-side by the Vercel Supabase integration. Never expose publicly.
POSTGRES_URL=

# Server-only Google Sheets sync for newly created partnership/referral submissions.
# Share the target spreadsheet with the service-account email as an editor.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Server-only Attio API token for the four-hour sheet-status watcher.
ATTIO_API_KEY=

# Server-only Hookdeck source and cron authentication.
HOOKDECK_SOURCE_URL=
CRON_SECRET=

# Browser-safe project token and canonical US ingestion host. Browser analytics
# uses the same-origin /ingest reverse proxy; server capture uses the real host.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional standard OpenTelemetry Logs configuration.
OTEL_SERVICE_NAME=rancher-web
POSTHOG_LOGS_ENDPOINT=https://us.i.posthog.com/i/v1/logs
# Server-only HMAC secret shared with the Cal.com webhook subscription.
CAL_WEBHOOK_SECRET=
# Dedicated Slack bot token. Required scopes: channels:history and chat:write.
# The bot must be a member of the target channel. Add groups:history instead of
# channels:history if the channel is private.
SLACK_FORM_SUBMISSIONS_BOT_TOKEN=
SLACK_FORM_SUBMISSIONS_CHANNEL_ID=C0C2HJ89ZUM

# Prismic delivery credentials are server/build-only. Default mode is prismic.
PRISMIC_REPOSITORY_NAME=
PRISMIC_ACCESS_TOKEN=
PRISMIC_LOCALE=en-us
PRISMIC_CONTENT_MODE=prismic
# One-time migration credentials; keep local, never prefix with PUBLIC_.
PRISMIC_CUSTOM_TYPES_TOKEN=
PRISMIC_WRITE_TOKEN=
