{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "rancher": {
    "color": {
      "$type": "color",
      "ink": { "$value": "#193e34", "$description": "Primary text, controls, and dark surfaces." },
      "muted": { "$value": "#536059", "$description": "Supporting copy on light surfaces." },
      "paper": { "$value": "#f7f6ee", "$description": "Default page background." },
      "surface": { "$value": "#fffef7", "$description": "Cards and raised light surfaces." },
      "line": { "$value": "#d9dfd3", "$description": "Default border and divider." },
      "lime": { "$value": "#d8ee8a", "$description": "Primary accent and light action surface." },
      "section": { "$value": "#eef0e5", "$description": "Alternating light section." },
      "sectionStrong": { "$value": "#e9eddf", "$description": "Calculator and demo section surface." },
      "sage": { "$value": "#e0e8cd", "$description": "Custom-card emphasis surface." },
      "active": { "$value": "#eaf0dc", "$description": "Selected tab and choice surface." },
      "hover": { "$value": "#f1f3e8", "$description": "Quiet hover surface." },
      "actionHover": { "$value": "#285648", "$description": "Primary action hover." },
      "focus": { "$value": "#658a2e", "$description": "Visible keyboard focus ring." },
      "accentText": { "$value": "#6c824c", "$description": "Italic editorial emphasis." },
      "success": { "$value": "#526b36", "$description": "Privacy-safe transformed value." },
      "warningSurface": { "$value": "#f3e3d5", "$description": "Sensitive-source highlight." },
      "warningText": { "$value": "#73563c", "$description": "Sensitive-source highlight text." }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["Georgia", "Times New Roman", "serif"] },
        "body": { "$value": ["Arial", "Helvetica", "sans-serif"] },
        "code": { "$value": ["monospace"] }
      },
      "size": {
        "$type": "dimension",
        "xs": { "$value": { "value": 10, "unit": "px" } },
        "sm": { "$value": { "value": 11, "unit": "px" } },
        "caption": { "$value": { "value": 12, "unit": "px" } },
        "bodySmall": { "$value": { "value": 13, "unit": "px" } },
        "body": { "$value": { "value": 16, "unit": "px" } },
        "lead": { "$value": { "value": 20, "unit": "px" } },
        "h3": { "$value": { "value": 20, "unit": "px" } },
        "h2Min": { "$value": { "value": 38, "unit": "px" } },
        "h2Max": { "$value": { "value": 58, "unit": "px" } },
        "h1Min": { "$value": { "value": 52, "unit": "px" } },
        "h1Max": { "$value": { "value": 90, "unit": "px" } }
      },
      "lineHeight": {
        "$type": "number",
        "displayTight": { "$value": 1.02 },
        "heading": { "$value": 1.1 },
        "body": { "$value": 1.6 },
        "relaxed": { "$value": 1.8 }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } },
      "25": { "$value": { "value": 100, "unit": "px" } }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": { "value": 4, "unit": "px" } },
      "button": { "$value": { "value": 5, "unit": "px" } },
      "card": { "$value": { "value": 8, "unit": "px" } },
      "panel": { "$value": { "value": 12, "unit": "px" } },
      "calculator": { "$value": { "value": 16, "unit": "px" } },
      "pill": { "$value": { "value": 9999, "unit": "px" } }
    },
    "border": {
      "width": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "default": { "$type": "color", "$value": "{rancher.color.line}" }
    },
    "layout": {
      "contentMax": { "$type": "dimension", "$value": { "value": 1240, "unit": "px" } },
      "contentMaxWide": { "$type": "dimension", "$value": { "value": 1360, "unit": "px" } },
      "gutterDesktop": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "gutterTablet": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
      "gutterMobile": { "$type": "dimension", "$value": { "value": 23, "unit": "px" } },
      "sectionDesktop": { "$type": "dimension", "$value": { "value": 100, "unit": "px" } },
      "sectionMobile": { "$type": "dimension", "$value": { "value": 65, "unit": "px" } },
      "navDesktop": { "$type": "dimension", "$value": { "value": 86, "unit": "px" } },
      "navMobile": { "$type": "dimension", "$value": { "value": 72, "unit": "px" } }
    },
    "breakpoint": {
      "$type": "dimension",
      "compact": { "$value": { "value": 400, "unit": "px" } },
      "mobile": { "$value": { "value": 760, "unit": "px" } },
      "tablet": { "$value": { "value": 1000, "unit": "px" } },
      "wide": { "$value": { "value": 1500, "unit": "px" } }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
      "caret": { "$type": "duration", "$value": { "value": 650, "unit": "ms" } },
      "hoverLift": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } }
    }
  }
}
