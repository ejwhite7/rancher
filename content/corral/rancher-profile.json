{
  "profile_id": "rancher",
  "version": "1.0.0",
  "extends_policies": {
    "universal-editorial": "1.0.0",
    "evidence": "1.0.0",
    "search-discoverability": "1.0.0"
  },
  "length": {
    "target_words": {
      "minimum": 1080,
      "maximum": 1650
    },
    "enforcement": "configurable"
  },
  "publishing": {
    "adapter": "prismic-corral",
    "authors": [
      "Edward White"
    ],
    "approval_required": true,
    "default_action": "dry-run",
    "link_rules": {
      "minimum_internal": 0,
      "minimum_external": 1,
      "maximum_external": 12
    }
  },
  "notes": "Edward White confirmed the byline and bio and accepted the pilots. Owner-managed Prismic publishing policy applies. Aim for 1200–1500 words; permitted tolerance is 1080–1650."
}
