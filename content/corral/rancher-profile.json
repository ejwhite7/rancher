{
  "profile_id": "rancher",
  "version": "1.0.0",
  "extends_policies": {
    "universal-editorial": "1.0.0",
    "evidence": "1.0.0",
    "search-discoverability": "1.0.0"
  },
  "length": {
    "target_words": {
      "minimum": 500,
      "maximum": 2000
    },
    "enforcement": "configurable"
  },
  "publishing": {
    "adapter": "prismic-corral",
    "authors": [
      "Edward White"
    ],
    "approval_required": true,
    "default_action": "dry-run",
    "link_rules": {
      "minimum_internal": 0,
      "minimum_external": 1,
      "maximum_external": 12
    }
  },
  "notes": "Edward White confirmed the byline and accepted the pilots. publishing-policy.json records his explicit waiver of editorial and specialist approval; the Rancher consumer adapter applies it without fabricating approvals. Bio pending his review."
}
