{
  "id": "footer",
  "label": "Footer",
  "repeatable": false,
  "status": true,
  "format": "custom",
  "json": {
    "Main": {
      "brand_name": {
        "type": "Text",
        "config": {
          "label": "Brand name"
        }
      },
      "brand_label": {
        "type": "Text",
        "config": {
          "label": "Home link accessibility label"
        }
      },
      "copyright": {
        "type": "Text",
        "config": {
          "label": "Copyright text (year added automatically)"
        }
      },
      "nav_label": {
        "type": "Text",
        "config": {
          "label": "Footer navigation accessibility label"
        }
      },
      "dialog_heading": {
        "type": "Text",
        "config": {
          "label": "Site information heading"
        }
      },
      "dialog_body": {
        "type": "StructuredText",
        "config": {
          "label": "Site information content",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "close_label": {
        "type": "Text",
        "config": {
          "label": "Dialog close button label"
        }
      },
      "items": {
        "type": "Group",
        "config": {
          "label": "Footer links (add, remove, or reorder)",
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "Link label"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link destination (use #site-note for site information)",
                "select": "web"
              }
            }
          }
        }
      },
      "socials": {
        "type": "Group",
        "config": {
          "label": "Social profiles (add, remove, or reorder)",
          "fields": {
            "platform": {
              "type": "Select",
              "config": {
                "label": "Platform logo",
                "options": [
                  "LinkedIn",
                  "Instagram",
                  "X"
                ]
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Company profile URL",
                "select": "web"
              }
            }
          }
        }
      }
    },
    "Legacy links": {
      "faq_label": {
        "type": "Text",
        "config": {
          "label": "FAQ link label"
        }
      },
      "privacy_label": {
        "type": "Text",
        "config": {
          "label": "Privacy link label"
        }
      },
      "terms_label": {
        "type": "Text",
        "config": {
          "label": "Terms link label"
        }
      },
      "information_label": {
        "type": "Text",
        "config": {
          "label": "Site information link label"
        }
      },
      "cta_label": {
        "type": "Text",
        "config": {
          "label": "Partnership link label"
        }
      },
      "cta_link": {
        "type": "Link",
        "config": {
          "label": "Partnership link destination",
          "select": "web"
        }
      }
    }
  }
}
