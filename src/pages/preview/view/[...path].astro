---
export const prerender = false;
import { asHTML, type RichTextField } from "@prismicio/client";
import Homepage from "../../../components/pages/Homepage.astro";
import LegalLayout from "../../../layouts/LegalLayout.astro";
import { fetchSiteContent } from "../../../lib/prismic";
import {
  validateLegalContent,
  parseNavigation,
  parseFooter,
} from "../../../lib/content";
import {
  createPreviewClient,
  PREVIEW_COOKIE,
  previewHeaders,
  validPreviewToken,
  supportedPreviewPath,
} from "../../../lib/preview";
for (const [k, v] of Object.entries(previewHeaders))
  Astro.response.headers.set(k, v);
const path = Astro.params.path || "";
if (!supportedPreviewPath(path ? `/${path}/` : "/"))
  return new Response("Preview page not found.", {
    status: 404,
    headers: previewHeaders,
  });
const token = Astro.cookies.get(PREVIEW_COOKIE)?.value;
if (!token || !validPreviewToken(token))
  return new Response(null, {
    status: 302,
    headers: { ...previewHeaders, Location: path ? `/${path}/` : "/" },
  });
let content;
let legal;
let referral;
import Referral from "../../../components/pages/Referral.astro";
import { fetchReferral } from "../../../lib/referral";
let contact;
import Contact from "../../../components/pages/Contact.astro";
import { fetchContact } from "../../../lib/contact";
let glossary;
let glossaryDocument;
import GlossaryIndex from "../../../components/pages/GlossaryIndex.astro";
import GlossaryTerm from "../../../components/pages/GlossaryTerm.astro";
import { fetchGlossary, glossarySiteContent } from "../../../lib/glossary";
try {
  const client = createPreviewClient(token);
  content = await fetchSiteContent(
    client,
    import.meta.env.PRISMIC_LOCALE || "en-us",
  );
  if (path === "glossary" || path.startsWith("glossary/")) {
    const lang = import.meta.env.PRISMIC_LOCALE || "en-us";
    glossary = await fetchGlossary(client, { preview: true, lang });
    if (path !== "glossary") {
      glossaryDocument = glossary.documents.find(
        (doc) => doc.uid === path.slice("glossary/".length),
      );
      if (!glossaryDocument)
        return new Response("Glossary preview term not found.", {
          status: 404,
          headers: previewHeaders,
        });
    }
    content = await glossarySiteContent(
      client,
      glossaryDocument?.data || glossary.index,
      lang,
    );
  } else if (path === "referral") {
    referral = await fetchReferral(
      client,
      import.meta.env.PRISMIC_LOCALE || "en-us",
    );
  } else if (path === "contact") {
    contact = await fetchContact(
      client,
      import.meta.env.PRISMIC_LOCALE || "en-us",
    );
  } else if (path) {
    legal = validateLegalContent((await client.getByUID("legal", path)).data);
    const [nav, footer] = await Promise.all([
      client.getByID(legal.navigation.id),
      client.getByID(legal.footer.id),
    ]);
    content = {
      ...content,
      navigation: parseNavigation(nav.data),
      footer: parseFooter(footer.data),
    };
  }
} catch {
  return new Response(
    "This preview has expired or contains incomplete content. Return to Prismic and open a new preview, or exit at /preview/exit/.",
    { status: 400, headers: previewHeaders },
  );
}
---

{referral ? (
  <Referral referral={referral} preview />
) : contact ? (
  <Contact contact={contact} preview />
) : glossary ? (
  glossaryDocument ? (
    <GlossaryTerm
      glossary={glossary}
      document={glossaryDocument}
      content={content}
      preview
    />
  ) : (
    <GlossaryIndex glossary={glossary} content={content} preview />
  )
) : legal ? (
  <LegalLayout
    title={legal.title}
    description={legal.description}
    legal={legal}
    content={content}
    preview
  >
    <Fragment set:html={asHTML(legal.body as RichTextField)} />
  </LegalLayout>
) : (
  <Homepage content={content} preview />
)}
