---
export const prerender = false;
import { NotFoundError } from "@prismicio/client";
import BlogIndex from "../../components/pages/BlogIndex.astro";
import {
  createBlogClient,
  fetchBlog,
  blogSiteContent,
  blogHeaders,
} from "../../lib/blog";
let blog, content;
try {
  const client = createBlogClient();
  blog = await fetchBlog(client);
  content = await blogSiteContent(client, blog.index);
} catch (error) {
  return new Response(
    error instanceof NotFoundError
      ? "Page not found."
      : "The Corral is temporarily unavailable.",
    {
      status: error instanceof NotFoundError ? 404 : 503,
      headers: { "Cache-Control": "no-store", "X-Robots-Tag": "noindex" },
    },
  );
}
for (const [k, v] of Object.entries(blogHeaders))
  Astro.response.headers.set(k, v);
---

<BlogIndex blog={blog} content={content} />
