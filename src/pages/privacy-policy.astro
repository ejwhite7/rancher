---
import { asHTML, type RichTextField } from "@prismicio/client";
import { getLegalContent } from "../lib/prismic";
import LegalLayout from "../layouts/LegalLayout.astro";
const legal = await getLegalContent("privacy-policy");
---

<LegalLayout title={legal.title} description={legal.description} legal={legal}>
  <Fragment set:html={asHTML(legal.body as RichTextField)} />
</LegalLayout>
