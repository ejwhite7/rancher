---
import "../styles/global.css";
import { getSiteContent } from "../lib/prismic";
import type { SiteContent } from "../lib/content";
const { homepage } = Astro.props.content || (await getSiteContent());
const preview = Astro.props.preview || false;
const repository = import.meta.env.PRISMIC_REPOSITORY_NAME;
import Attributor from "../components/Attributor.astro";
import PostHog from "../components/posthog.astro";
import { canonicalUrl } from "../lib/site";
import { structuredData } from "../lib/seo";
interface Props {
  content?: SiteContent;
  preview?: boolean;
  title?: string;
  description?: string;
  faqs?: { question: string; answer: string }[];
  socialImage?:
    | {
        url: string;
        alt?: string | null;
        dimensions: { width: number; height: number };
      }
    | {}
    | null;
  glossarySchema?: Record<string, unknown>;
  article?: { author: string; published: string; modified: string };
}
const {
  title = homepage.meta_title,
  description = homepage.meta_description,
  faqs,
} = Astro.props;
const site = Astro.site!;
const canonical = canonicalUrl(Astro.url.pathname);
const socialImage =
  Astro.props.socialImage && "url" in Astro.props.socialImage
    ? Astro.props.socialImage
    : homepage.social_image;
const image = new URL(socialImage.url, site);
const imageAlt = socialImage.alt || title;
const robots =
  !preview && import.meta.env.PUBLIC_SITE_INDEXABLE
    ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    : "noindex, nofollow";
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={Astro.props.article?.author || "Rancher"} />
    <meta name="application-name" content="Rancher" />
    <meta name="theme-color" content="#173f35" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href="/favicon.ico"
    />
    <link rel="icon" type="image/svg+xml" href="/images/rancher-logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      property="og:type"
      content={Astro.props.article ? "article" : "website"}
    />
    {Astro.props.article && (
      <>
        <meta
          property="article:published_time"
          content={Astro.props.article.published}
        />
        <meta
          property="article:modified_time"
          content={Astro.props.article.modified}
        />
        <meta property="article:author" content={Astro.props.article.author} />
      </>
    )}
    <meta property="og:site_name" content="Rancher" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta
      property="og:image:width"
      content={String(socialImage.dimensions.width)}
    />
    <meta
      property="og:image:height"
      content={String(socialImage.dimensions.height)}
    />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <Attributor />
    <PostHog />
    {Astro.props.glossarySchema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(Astro.props.glossarySchema).replace(
          /</g,
          "\\u003c",
        )}
      ></script>
    )}
    {repository && (
      <script
        is:inline
        async
        defer
        src={`https://static.cdn.prismic.io/prismic.js?new=true&repo=${repository}`}
      ></script>
    )}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredData(
          site,
          canonical,
          { title, description },
          faqs,
          { ...socialImage, alt: imageAlt },
          homepage.meta_description,
        ),
      ).replace(/</g, "\\u003c")}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {preview && (
      <aside class="preview-notice">
        Draft preview · <a href="/preview/exit/">Exit preview</a>
      </aside>
    )}
    <slot />
    {preview && <script is:inline>
      document.addEventListener("click", (event) => {
        const anchor =
          event.target instanceof Element
            ? event.target.closest("a[href]")
            : null;
        if (
          !anchor ||
          event.defaultPrevented ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey ||
          anchor.target ||
          anchor.hasAttribute("download")
        )
          return;
        const url = new URL(anchor.href, location.href);
        if (
          url.origin !== location.origin ||
          url.pathname.startsWith("/preview/")
        )
          return;
        if (
          [
            "/",
            "/privacy-policy/",
            "/terms-of-use/",
            "/contact/",
            "/referral/",
          ].includes(url.pathname) ||
          /^\/(?:glossary|blog|authors)\/(?:[a-z0-9]+(?:-[a-z0-9]+)*\/)?$/.test(
            url.pathname,
          )
        ) {
          event.preventDefault();
          location.assign(
            "/preview/view" + url.pathname + url.search + url.hash,
          );
        }
      });
    </script>}
  </body>
</html>
