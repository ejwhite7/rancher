---
import { getFooterContent, getNavigationContent } from "../lib/prismic";
import SiteLayout from "./SiteLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import type { LegalContent, SiteContent } from "../lib/content";
interface Props {
  title: string;
  description: string;
  legal: LegalContent;
  content?: SiteContent;
  preview?: boolean;
}
const { title, description, legal, content, preview = false } = Astro.props;
const [navigation, footer] = await Promise.all([
  content
    ? Promise.resolve(content.navigation)
    : getNavigationContent(legal.navigation.id),
  content ? Promise.resolve(content.footer) : getFooterContent(legal.footer.id),
]);
---

<SiteLayout
  content={content}
  preview={preview}
  title={`${title} | Rancher`}
  description={description}
>
  <Navigation copy={navigation} homeLinks />
  <main id="main-content" class="legal-page">
    <article class="wrap legal-content">
      <a class="textlink" href="/">
        ← Back to Rancher
      </a>
      <header class="legal-heading">
        <h1>{title}</h1>
        <p>
          Last updated{" "}
          <time datetime={legal.updated}>{legal.updated_label}</time>
        </p>
      </header>
      <div class="legal-body">
        <slot />
      </div>
      {legal.contact_email && (
        <section class="legal-body">
          <h2>Contact</h2>
          <p>
            For questions about this page, contact {legal.operator} at{" "}
            <a href={`mailto:${legal.contact_email}`}>{legal.contact_email}</a>.
          </p>
        </section>
      )}
      <nav class="legal-related" aria-label="Legal pages">
        <a
          href="/privacy-policy/"
          aria-current={
            Astro.url.pathname === "/privacy-policy/" ? "page" : undefined
          }
        >
          Privacy Policy
        </a>
        <a
          href="/terms-of-use/"
          aria-current={
            Astro.url.pathname === "/terms-of-use/" ? "page" : undefined
          }
        >
          Terms of Use
        </a>
      </nav>
    </article>
  </main>
  <Footer copy={footer} />
</SiteLayout>
