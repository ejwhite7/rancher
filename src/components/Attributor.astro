<script is:inline src="/vendor/attributor/attributor-2.1.1.js"></script>
<script is:inline>
  function deleteAttributionCookies() {
    for (const name of ["attr_first", "attr_last"]) {
      document.cookie = `${name}=; Max-Age=0; path=/`;
      document.cookie = `${name}=; Max-Age=0; path=/; domain=.gorancher.com`;
    }
  }

  window.addEventListener("rancher:consent", (event) => {
    if (!event.detail.advertising) {
      deleteAttributionCookies();
      delete window.__attribution;
      return;
    }
    if (window.__attribution || typeof window.Attributor !== "function") return;

    const host = window.location.hostname;
    const cookieDomain =
      host === "gorancher.com" || host.endsWith(".gorancher.com")
        ? "gorancher.com"
        : "";
    const keys = [
      "source",
      "medium",
      "campaign",
      "term",
      "content",
      "id",
      "source_platform",
      "marketing_tactic",
      "creative_format",
      "adextension",
      "adgroup",
      "adgroupid",
      "adplacement",
      "adposition",
      "campaignid",
      "geo",
      "keymatch",
      "device",
      "matchtype",
      "network",
    ];
    const fieldMap = {
      first: Object.fromEntries(
        keys.map((key) => [key, `attribution_first_${key}`]),
      ),
      last: Object.fromEntries(
        keys.map((key) => [key, `attribution_last_${key}`]),
      ),
    };
    window.__attribution = new window.Attributor({ cookieDomain, fieldMap });
  });
</script>
