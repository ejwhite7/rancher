---
import type { HomepageContent, FormContent } from "../lib/content";
import RichText from "./RichText.astro";
import PartnershipForm from "./PartnershipForm";
interface Props {
  copy: HomepageContent["contact"];
  form: FormContent;
}
const { copy, form } = Astro.props;
---

<section class="section" id="contact">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <div class="eyebrow">{copy.eyebrow}</div>
      <RichText value={copy.heading} />
      <RichText value={copy.description} />
      <div class="mini">
        <RichText value={copy.note} />
      </div>
    </div>
    <PartnershipForm copy={form} client:idle />
  </div>
</section>
