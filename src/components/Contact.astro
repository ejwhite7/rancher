---
import PartnershipForm from "./PartnershipForm";
---

<section class="section" id="contact">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <div class="eyebrow">Let’s see what’s possible</div>
      <h2>
        You’ve built a business.
        <br />
        Let’s uncover what
        <br />
        else it can grow.
      </h2>
      <p>
        Start with the basics. Tell us about your business and data footprint,
        then book a conversation about the opportunity.
      </p>
      <p class="mini">
        No data uploads. No system credentials.
        <br />
        Just a starting point for a better conversation.
      </p>
    </div>
    <PartnershipForm client:idle />
  </div>
</section>
