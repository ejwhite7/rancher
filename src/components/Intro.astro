---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";

interface Props {
  copy: HomepageContent["opportunity"];
}
const { copy } = Astro.props;
---

<section class="section intro" id="opportunity">
  <div class="wrap intro-grid">
    <div>
      <div class="eyebrow">{copy.eyebrow}</div>
      <RichText value={copy.heading} />
    </div>
    <div>
      <RichText value={copy.lead} lead />
      <RichText value={copy.body} />
    </div>
  </div>
</section>
