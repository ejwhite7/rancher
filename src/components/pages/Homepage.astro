---
import type { SiteContent } from "../../lib/content";
interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;
const { homepage, form, navigation, footer } = content;
import { richText } from "../../lib/content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Navigation from "../Navigation.astro";
import Footer from "../Footer.astro";
import CorralEntry from "../CorralEntry.astro";
import PageSections from "../PageSections.astro";
---

<SiteLayout
  content={content}
  preview={preview}
  title={homepage.meta_title}
  description={homepage.meta_description}
  faqs={homepage.faq.items.map((item) => ({
    question: item.question,
    answer: richText(item.answer),
  }))}
>
  <Navigation copy={navigation} />
  <main id="main-content">
    <PageSections homepage={homepage} form={form} />
    <CorralEntry preview={preview} />
  </main>
  <Footer copy={footer} />
</SiteLayout>
