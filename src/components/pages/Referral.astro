---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Navigation from "../Navigation.astro";
import Footer from "../Footer.astro";
import ReferralForm from "../ReferralForm";
import type { ReferralContent } from "../../lib/referral";
import "../../styles/referral.css";
interface Props {
  referral: ReferralContent;
  preview?: boolean;
}
const { referral, preview = false } = Astro.props;
---

<SiteLayout
  content={referral.content}
  title={referral.page.meta_title}
  description={referral.page.meta_description}
  preview={preview}
>
  <Navigation copy={referral.content.navigation} homeLinks />
  <main id="main-content" class="referral-page">
    <div class="wrap">
      <nav class="referral-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{referral.page.heading}</span>
      </nav>
      <div class="referral-layout">
        <ReferralForm copy={referral.form} preview={preview} client:load />
        <article
          class="referral-explainer"
          aria-labelledby="referral-offer-heading"
        >
          <header>
            <h1 id="referral-offer-heading">{referral.page.offer_heading}</h1>
            <p>{referral.page.offer_introduction}</p>
          </header>
          <hr />
          <section aria-labelledby="referral-requirements-heading">
            <h2 id="referral-requirements-heading">
              {referral.page.requirements_heading}
            </h2>
            <ul>
              {referral.page.requirements.map((item) => (
                <li>{item.text}</li>
              ))}
            </ul>
          </section>
          <section aria-labelledby="referral-steps-heading">
            <h2 id="referral-steps-heading">{referral.page.steps_heading}</h2>
            <ul>
              {referral.page.steps.map((item) => (
                <li>{item.text}</li>
              ))}
            </ul>
          </section>
        </article>
      </div>
    </div>
  </main>
  <Footer copy={referral.content.footer} />
</SiteLayout>
