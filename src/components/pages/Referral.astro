---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Navigation from "../Navigation.astro";
import Footer from "../Footer.astro";
import ReferralForm from "../ReferralForm";
import type { ReferralContent } from "../../lib/referral";
import "../../styles/referral.css";
interface Props {
  referral: ReferralContent;
  preview?: boolean;
}
const { referral, preview = false } = Astro.props;
---

<SiteLayout
  content={referral.content}
  title={referral.page.meta_title}
  description={referral.page.meta_description}
  preview={preview}
>
  <Navigation copy={referral.content.navigation} homeLinks />
  <main id="main-content" class="referral-page">
    <div class="wrap">
      <nav class="referral-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{referral.page.heading}</span>
      </nav>
      <div class="referral-layout">
        <ReferralForm copy={referral.form} preview={preview} client:load />
      </div>
    </div>
  </main>
  <Footer copy={referral.content.footer} />
</SiteLayout>
