---
import type { FooterContent } from "../lib/content";
import SocialIcon from "./SocialIcon.astro";
import RichText from "./RichText.astro";
interface Props {
  copy: FooterContent;
}
const { copy } = Astro.props;
const homePath = Astro.url.pathname === "/" ? "" : "/";
---

<footer class="footer h-card">
  <div class="wrap">
    <div class="footer-top">
      <a href="/" class="brand p-name u-url" aria-label={copy.brand_label}>
        <svg viewBox="0 0 32 34" fill="none" aria-hidden="true">
          <path
            d="M3 29V6l13-4 13 4v23M3 18l13-4 13 4M10 31V10m12 21V10M3 25l13-4 13 4"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
        </svg>
        {copy.brand_name}
      </a>
      {copy.socials.length > 0 && <nav class="footer-socials" aria-label="Rancher social profiles">
        {copy.socials.map((social) => <a href={social.link} aria-label={`Rancher on ${social.platform}`} title={`Rancher on ${social.platform}`} target="_blank" rel="me noopener noreferrer"><SocialIcon platform={social.platform}/></a>)}
      </nav>}
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {copy.copyright}
      </span>
      <nav aria-label={copy.nav_label}>
        {copy.items.map((item) => (
          <a
            href={
              item.link.startsWith("#") && item.link !== "#site-note"
                ? homePath + item.link
                : item.link
            }
            data-dialog={item.link === "#site-note" ? "site-note" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
<dialog id="site-note" aria-labelledby="site-title">
  <h2 id="site-title">{copy.dialog_heading}</h2>
  <RichText value={copy.dialog_body} />
  <button class="btn" data-close>
    {copy.close_label}
  </button>
</dialog>
<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-dialog]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const dialog = document.getElementById(link.dataset.dialog ?? "");
        if (dialog instanceof HTMLDialogElement) {
          event.preventDefault();
          dialog.showModal();
        }
      });
    });
  document.querySelectorAll("[data-close]").forEach((button) => {
    button.addEventListener("click", () => button.closest("dialog")?.close());
  });
  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close();
    });
  });
</script>

<style>
.footer-top {display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap;}
.footer-socials {display:flex;gap:8px;align-items:center;}
.footer-socials a {display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;color:var(--ink);border-radius:50%;}
.footer-socials a:hover {background:var(--line);}
.footer-socials a:focus-visible {outline:2px solid currentColor;outline-offset:3px;}
</style>
