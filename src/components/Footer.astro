---
import type { FooterContent } from "../lib/content";
import RichText from "./RichText.astro";
interface Props {
  copy: FooterContent;
}
const { copy } = Astro.props;
const homePath = Astro.url.pathname === "/" ? "" : "/";
---

<footer class="footer h-card">
  <div class="wrap">
    <div class="footer-top">
      <a href="/" class="brand p-name u-url" aria-label={copy.brand_label}>
        <svg viewBox="0 0 32 34" fill="none" aria-hidden="true">
          <path
            d="M3 29V6l13-4 13 4v23M3 18l13-4 13 4M10 31V10m12 21V10M3 25l13-4 13 4"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
        </svg>
        {copy.brand_name}
      </a>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} {copy.copyright}
      </span>
      <nav aria-label={copy.nav_label}>
        <a href={`${homePath}#faq`}>{copy.faq_label}</a>
        <a href="/privacy-policy/">{copy.privacy_label}</a>
        <a href="/terms-of-use/">{copy.terms_label}</a>
        <a href="#site-note" data-dialog="site-note">
          {copy.information_label}
        </a>
        <a
          href={
            copy.cta_link.startsWith("#")
              ? homePath + copy.cta_link
              : copy.cta_link
          }
        >
          {copy.cta_label}
        </a>
      </nav>
    </div>
  </div>
</footer>
<dialog id="site-note" aria-labelledby="site-title">
  <h2 id="site-title">{copy.dialog_heading}</h2>
  <RichText value={copy.dialog_body} />
  <button class="btn" data-close>
    {copy.close_label}
  </button>
</dialog>
<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-dialog]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const dialog = document.getElementById(link.dataset.dialog ?? "");
        if (dialog instanceof HTMLDialogElement) {
          event.preventDefault();
          dialog.showModal();
        }
      });
    });
  document.querySelectorAll("[data-close]").forEach((button) => {
    button.addEventListener("click", () => button.closest("dialog")?.close());
  });
  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close();
    });
  });
</script>
