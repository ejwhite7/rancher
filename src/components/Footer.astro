---
const homePath = Astro.url.pathname === "/" ? "" : "/";
---

<footer class="footer h-card">
  <div class="wrap">
    <div class="footer-top">
      <a href="/" class="brand p-name u-url" aria-label="Rancher home">
        <svg viewBox="0 0 32 34" fill="none" aria-hidden="true">
          <path
            d="M3 29V6l13-4 13 4v23M3 18l13-4 13 4M10 31V10m12 21V10M3 25l13-4 13 4"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
          />
        </svg>
        rancher
      </a>
    </div>
    <div class="footer-bottom">
      <span>
        © {new Date().getFullYear()} Rancher. Cultivate what comes next.
      </span>
      <nav aria-label="Footer">
        <a href={`${homePath}#faq`}>FAQs</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-use/">Terms of Use</a>
        <a href="#site-note" data-dialog="site-note">
          Site information
        </a>
        <a href={`${homePath}#contact`}>Start a partnership ↗</a>
      </nav>
    </div>
  </div>
</footer>
<dialog id="site-note" aria-labelledby="site-title">
  <h2 id="site-title">About this webpage</h2>
  <p>
    This is a Rancher service website concept. Its service descriptions outline
    a proposed offering, not verified operational capabilities or a binding
    offer. No AI-lab relationships, earnings, customers, or certifications are
    claimed.
  </p>
  <p>
    The inquiry form saves your contact details and business summary so Rancher
    can follow up. Any data partnership requires a separate written agreement.
  </p>
  <button class="btn" data-close>
    Close
  </button>
</dialog>
<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-dialog]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const dialog = document.getElementById(link.dataset.dialog ?? "");
        if (dialog instanceof HTMLDialogElement) {
          event.preventDefault();
          dialog.showModal();
        }
      });
    });
  document.querySelectorAll("[data-close]").forEach((button) => {
    button.addEventListener("click", () => button.closest("dialog")?.close());
  });
  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close();
    });
  });
</script>
