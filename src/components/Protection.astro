<section class="section" id="protection">
  <div class="wrap">
    <div class="privacy-grid">
      <div class="privacy-copy">
        <div class="eyebrow">Your data. Your boundaries.</div>
        <h2>
          Value shouldn’t come
          <br />
          at the cost of control.
        </h2>
        <p>
          Good data partnerships start with clear permissions. Build the scope,
          handling requirements, and buyer obligations into the agreement—not
          into an afterthought.
        </p>
        <ul class="checks">
          <li>Choose eligible systems, date ranges, and exclusions.</li>
          <li>Define de-identification and review requirements.</li>
          <li>Specify permitted uses and onward-sharing restrictions.</li>
          <li>Agree on retention, deletion, and payment terms.</li>
        </ul>
      </div>
      <div class="privacy-demo">
        <div class="demo-header">
          <span>CONTEXT IN. IDENTIFIERS OUT.</span>
          <span>↗</span>
        </div>
        <div class="demo-card">
          <small>ILLUSTRATIVE SOURCE RECORD</small>
          <p
            class="type-line"
            aria-label="Alex Chen resolved the renewal blocker for Acme Co. after the support handoff."
          >
            <mark>
              <span data-type-text="Alex Chen">Alex Chen</span>
            </mark>
            <span data-type-text=" resolved the renewal blocker for ">
              {" "}
              resolved the renewal blocker for{" "}
            </span>
            <mark>
              <span data-type-text="Acme Co.">Acme Co.</span>
            </mark>
            <span data-type-text=" after the support handoff.">
              {" "}
              after the support handoff.
            </span>
          </p>
        </div>
        <div class="connector" aria-hidden="true">
          ↓
        </div>
        <div class="demo-card safe">
          <small>ILLUSTRATIVE PREPARED RECORD</small>
          <p
            class="type-line"
            aria-label="PERSON_01 resolved the renewal blocker for COMPANY_02 after the support handoff."
          >
            <mark>
              <span data-type-text="PERSON_01">PERSON_01</span>
            </mark>
            <span data-type-text=" resolved the renewal blocker for ">
              {" "}
              resolved the renewal blocker for{" "}
            </span>
            <mark>
              <span data-type-text="COMPANY_02">COMPANY_02</span>
            </mark>
            <span data-type-text=" after the support handoff.">
              {" "}
              after the support handoff.
            </span>
          </p>
        </div>
      </div>
    </div>
    <div class="values">
      <article>
        <h3>Ownership stays with you.</h3>
        <p>
          A license grants defined usage rights. It doesn’t have to mean selling
          ownership of your underlying data.
        </p>
      </article>
      <article>
        <h3>No blanket permissions.</h3>
        <p>
          Buyer access, exclusivity, and future uses belong in the terms you
          review and approve.
        </p>
      </article>
      <article>
        <h3>Fit before a forecast.</h3>
        <p>
          Value depends on buyer demand, usable history, quality, and rights—not
          a universal price per record.
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".privacy-demo").forEach((demo) => {
    const lines = Array.from(demo.querySelectorAll<HTMLElement>(".type-line"));
    if (!lines.length || reduceMotion.matches) return;

    const segments = lines.map((line) =>
      Array.from(line.querySelectorAll<HTMLElement>("[data-type-text]")),
    );
    const totals = segments.map((parts) =>
      parts.reduce(
        (sum, part) => sum + (part.dataset.typeText?.length ?? 0),
        0,
      ),
    );

    const render = (progress: number) => {
      segments.forEach((parts, lineIndex) => {
        let remaining = Math.floor(totals[lineIndex] * progress);
        parts.forEach((part) => {
          const text = part.dataset.typeText ?? "";
          const visible = Math.min(text.length, Math.max(0, remaining));
          part.textContent = text.slice(0, visible);
          remaining -= text.length;
        });
      });
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        render(0);
        lines.forEach((line) => line.classList.add("is-typing"));

        const start = performance.now();
        const duration = 3300;
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration);
          render(progress);
          if (progress < 1) requestAnimationFrame(tick);
          else lines.forEach((line) => line.classList.remove("is-typing"));
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.45 },
    );

    observer.observe(demo);
  });
</script>
