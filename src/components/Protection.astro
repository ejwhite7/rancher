---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";
import AnimatedRecord from "./AnimatedRecord.astro";
interface Props {
  copy: HomepageContent["protection"];
}
const { copy } = Astro.props;
---

<section class="section" id="protection">
  <div class="wrap">
    <div class="privacy-grid">
      <div class="privacy-copy">
        <div class="eyebrow">{copy.eyebrow}</div>
        <RichText value={copy.heading} />
        <RichText value={copy.description} />
        <ul class="checks">
          {copy.checks.map((item) => (
            <li>{item.text}</li>
          ))}
        </ul>
      </div>
      <div class="privacy-demo">
        <div class="demo-header">
          <span>{copy.demo_heading}</span>
          <span>↗</span>
        </div>
        <div class="demo-card">
          <small>{copy.source_label}</small>
          <AnimatedRecord value={copy.source_record} />
        </div>
        <div class="connector" aria-hidden="true">
          ↓
        </div>
        <div class="demo-card safe">
          <small>{copy.prepared_label}</small>
          <AnimatedRecord value={copy.prepared_record} />
        </div>
      </div>
    </div>
    <div class="values">
      {copy.items.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".privacy-demo").forEach((demo) => {
    const lines = Array.from(demo.querySelectorAll<HTMLElement>(".type-line"));
    if (!lines.length || reduceMotion.matches) return;

    const segments = lines.map((line) =>
      Array.from(line.querySelectorAll<HTMLElement>("[data-type-text]")),
    );
    const totals = segments.map((parts) =>
      parts.reduce(
        (sum, part) => sum + (part.dataset.typeText?.length ?? 0),
        0,
      ),
    );

    const render = (progress: number) => {
      segments.forEach((parts, lineIndex) => {
        let remaining = Math.floor(totals[lineIndex] * progress);
        parts.forEach((part) => {
          const text = part.dataset.typeText ?? "";
          const visible = Math.min(text.length, Math.max(0, remaining));
          part.textContent = text.slice(0, visible);
          remaining -= text.length;
        });
      });
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        render(0);
        lines.forEach((line) => line.classList.add("is-typing"));

        const start = performance.now();
        const duration = 3300;
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration);
          render(progress);
          if (progress < 1) requestAnimationFrame(tick);
          else lines.forEach((line) => line.classList.remove("is-typing"));
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.45 },
    );

    observer.observe(demo);
  });
</script>
