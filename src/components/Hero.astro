---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";
interface Props {
  copy: HomepageContent["hero"];
}
const { copy } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <RichText value={copy.heading} />
        <RichText value={copy.description} />
        <div class="hero-actions">
          <a class="btn" href={copy.cta_link}>
            {copy.cta_label}{" "}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <a class="textlink" href={copy.secondary_link}>
            {copy.secondary_label}
          </a>
        </div>
      </div>
      <div class="landscape">
        <svg viewBox="0 0 560 490" role="img" aria-labelledby="land-title">
          <title id="land-title">{copy.illustration_alt}</title>
          <defs>
            <linearGradient id="sky" x2="0" y2="1">
              <stop stop-color="#e8edda" />
              <stop offset="1" stop-color="#f7f6ee" />
            </linearGradient>
            <clipPath id="field">
              <path d="M19 276 279 144 548 275 287 429Z" />
            </clipPath>
          </defs>
          <circle class="farm-sky" cx="302" cy="224" r="196" fill="url(#sky)" />
          <circle class="field-sun" cx="380" cy="118" r="34" fill="#d9e69f" />
          <path
            d="M51 165h57m-43 10h74m274-19h61"
            stroke="#c9d4bc"
            stroke-width="1"
          />
          <path d="M19 276v17l268 137v-17M287 430l261-136v-19" fill="#bac797" />
          <path d="M19 276 279 144 548 275 287 413Z" fill="#c6d4a4" />
          <g clip-path="url(#field)">
            <path d="m14 276 117-63 268 137-111 65Z" fill="#a0b373" />
            <path d="m132 213 92-46 270 138-94 47Z" fill="#dce5b2" />
            <path d="m226 167 54-28 274 136-60 31Z" fill="#7b9761" />
            <g stroke="#f0f2cf" stroke-width="2" opacity=".9">
              <path d="m20 254 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145m-244-175 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145m-260-157 282 145" />
            </g>
            <path
              d="m168 199 277 141M59 300l265-134"
              stroke="#f8f7e9"
              stroke-width="12"
            />
            <path
              d="m168 199 277 141M59 300l265-134"
              stroke="#dddcc5"
              stroke-width="1"
            />
          </g>
          <g
            class="field-plants"
            fill="#416b48"
            stroke="#416b48"
            stroke-linecap="round"
          >
            <path
              d="M354 185v-35m0 24q-17-1-17-16 17 1 17 16m0-10q16 0 17-15-16 0-17 15M391 204v-35m0 24q-17-1-17-16 17 1 17 16m0-10q16 0 17-15-16 0-17 15M429 223v-35m0 24q-17-1-17-16 17 1 17 16m0-10q16 0 17-15-16 0-17 15"
              stroke-width="2"
            />
          </g>
          <g transform="translate(155 237)">
            <path d="m0 0 46-24 41 22-46 24Z" fill="#f9f6dd" />
            <path d="M0 0v33l41 22V22Z" fill="#f0ead0" />
            <path d="m41 22 46-24v33L41 55Z" fill="#bac5a0" />
            <path d="M-7 2 13-34 55-12 41 28Z" fill="#345b47" />
            <path d="m13-34 46-24 34 51-38-5Z" fill="#517352" />
            <path d="m54 23 17-9v27l-17 9Z" fill="#547155" />
            <path d="M10 17v10l12 6V23Z" fill="#a8bd8c" />
          </g>
          <g fill="#698351">
            <ellipse cx="99" cy="261" rx="6" ry="3" />
            <ellipse cx="119" cy="272" rx="6" ry="3" />
            <ellipse cx="139" cy="282" rx="6" ry="3" />
            <ellipse cx="159" cy="292" rx="6" ry="3" />
            <ellipse cx="179" cy="302" rx="6" ry="3" />
            <ellipse cx="199" cy="312" rx="6" ry="3" />
          </g>
          <path
            d="m279 144 0-49m-260 181-1 29m530-30 0 30"
            stroke="#9aac83"
            stroke-dasharray="3 5"
          />
          <circle cx="279" cy="92" r="4" fill="#7d9851" />
          <path d="M176 453h214" stroke="#d8dfc9" />
        </svg>
        <div class="float-label label-top">
          <span>{copy.source_label}</span>
          <b>{copy.source_caption}</b>
        </div>
        <div class="float-label label-bottom">
          <span>{copy.outcome_label}</span>
          <b>
            <i></i>
            {copy.outcome_caption}
          </b>
        </div>
      </div>
    </div>
    <div class="hero-foot">
      <strong>{copy.trust_heading}</strong>
      <div>
        {copy.items.map((item) => (
          <span>
            <span class="tick">✓</span>
            {item.text}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { createTimeline, animate } from "animejs";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".landscape").forEach((landscape) => {
    const sun = landscape.querySelector<SVGElement>(".field-sun");
    const plants = landscape.querySelector<SVGGElement>(".field-plants");
    const sky = landscape.querySelector<SVGElement>(".farm-sky");
    if (!sun || !plants || !sky || reduceMotion.matches) return;

    plants.style.transformBox = "fill-box";
    plants.style.transformOrigin = "center bottom";

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();

        createTimeline({ loop: true })
          .add(
            sun,
            {
              translateY: [105, 0],
              opacity: [0.35, 1],
              duration: 2600,
              ease: "inOutSine",
            },
            0,
          )
          .add(sky, { opacity: [0.55, 1], duration: 2200, ease: "outQuad" }, 0)
          .add(
            plants,
            {
              scaleY: [0.08, 1],
              opacity: [0.45, 1],
              duration: 3000,
              ease: "outElastic(1, .55)",
            },
            550,
          )
          .add(
            plants,
            {
              rotate: [-0.8, 0.8],
              duration: 1450,
              alternate: true,
              loop: 2,
              ease: "inOutSine",
            },
            3550,
          )
          .add(
            sun,
            {
              translateY: 105,
              opacity: 0.3,
              duration: 2800,
              ease: "inOutSine",
            },
            5700,
          )
          .add(sky, { opacity: 0.55, duration: 2400, ease: "inOutSine" }, 5900)
          .add({}, { duration: 650 }, 8500);
      },
      { threshold: 0.35 },
    );

    observer.observe(landscape);
  });

  reduceMotion.addEventListener("change", ({ matches }) => {
    if (matches) {
      animate(".field-sun, .field-plants, .farm-sky", {
        translateY: 0,
        scaleY: 1,
        rotate: 0,
        opacity: 1,
        duration: 0,
      });
    }
  });
</script>
