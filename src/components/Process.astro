---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";

interface Props {
  copy: HomepageContent["process"];
}
const { copy } = Astro.props;
---

<section class="section dark" id="how-it-works">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">{copy.eyebrow}</div>
        <RichText value={copy.heading} />
      </div>
      <RichText value={copy.description} />
    </div>
    <div class="steps">
      {copy.items.map((item, index) => (
        <article class="step">
          <div class="step-num">{String(index + 1).padStart(2, "0")} /</div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <div class="process-foot">
      <a class="btn light" href={copy.cta_link}>
        {copy.cta_label} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
