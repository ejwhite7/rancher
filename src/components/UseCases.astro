---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";

interface Props {
  copy: HomepageContent["use_cases"];
}
const { copy } = Astro.props;
---

<section class="section gallery" id="use-cases">
  <div class="wrap">
    <div class="section-head">
      <div>
        <RichText value={copy.heading} />
      </div>
      <RichText value={copy.description} />
    </div>
    <div class="use-grid">
      {copy.items.map((item) => (
        <article class="use-card">
          <div class="platform-strip">
            <img
              src={item.image.url}
              width="420"
              height="30"
              alt={item.image.alt}
              loading="lazy"
            />
          </div>
          <p class="platform-names">{item.platforms}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
      <article class="use-card custom-card">
        <div class="eyebrow">{copy.custom_eyebrow}</div>
        <h3>{copy.custom_title}</h3>
        <RichText value={copy.custom_description} />
        <a class="btn" href={copy.cta_link}>
          {copy.cta_label} <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
    <div class="under-note">
      <RichText value={copy.note} />
    </div>
  </div>
</section>
