---
import type { HomepageContent } from "../lib/content";
import RichText from "./RichText.astro";
import DataTabs from "./DataTabs";
interface Props {
  copy: HomepageContent["data_categories"];
}
const { copy } = Astro.props;
---

<section class="section" id="data">
  <div class="wrap">
    <div class="section-head">
      <div>
        <RichText value={copy.heading} />
      </div>
    </div>
    <DataTabs copy={copy} client:visible={{ rootMargin: "300px" }} />
    <div class="under-note">
      <RichText value={copy.note} />
    </div>
  </div>
</section>
